# Copy to .env (never commit .env)

# LLM permit extraction: "live" calls the API, "cached" uses fixtures (offline demo)
LLM_MODE=cached
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# "Today" for severity urgency, so demo numbers stay stable
DEMO_DATE=2026-10-28

# CORS origin of the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
