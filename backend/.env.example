# Copy to .env (never commit .env)

# LLM permit extraction: "live" calls the API, "cached" uses fixtures (offline demo)
LLM_MODE=cached
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# "Today" for severity urgency, so demo numbers stay stable
DEMO_DATE=2026-10-28

# CORS origin of the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Request logs: one JSON line per request with the real client IP.
# Trusted proxies in front of the app (0 = use the socket address; Render = 1).
# X-Forwarded-For is read this many entries from the right; the leftmost is client-controlled.
TRUSTED_PROXY_HOPS=0
# Honour CF-Connecting-IP / True-Client-IP only when Cloudflare is in front
TRUST_CF_HEADERS=false
# full | masked (last IPv4 octet / last 80 bits of IPv6 zeroed) | off
LOG_CLIENT_IP=masked
# Serves GET /api/debug/headers to find the client's position in X-Forwarded-For; keep false otherwise
DEBUG_HEADERS=false

# Render start command (single worker: the store is in memory).
# --no-proxy-headers is required on EVERY uvicorn start: uvicorn enables proxy headers by default and
#   trusts X-Forwarded-For from FORWARDED_ALLOW_IPS (default 127.0.0.1), rewriting the socket address
#   our logs fall back to. Never add --proxy-headers or --forwarded-allow-ips.
# --no-access-log: our JSON line is the only access line (uvicorn's would show the proxy IP).
#   uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1 --no-access-log --no-proxy-headers
